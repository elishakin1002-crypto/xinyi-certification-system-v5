KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.5
GEMINI_API_KEY=
# 余额不足/限流时自动兜底模型（可按账号可用模型调整）
GEMINI_MODEL=gemini-3-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
VITE_KIMI_MODEL=kimi-k2.5
# 测试/生产默认使用同源 /api，避免浏览器访问用户本机 localhost:3001。
VITE_AI_BACKEND_URL=/api/ai
VITE_AI_CHAT_TIMEOUT_MS=30000
VITE_AI_GENERATE_TIMEOUT_MS=45000
VITE_AI_DEFAULT_TIMEOUT_MS=20000
# Contract extraction staged timeout (front-end request timeout)
VITE_CONTRACT_AI_PRIMARY_TIMEOUT_MS=55000
VITE_CONTRACT_AI_SECONDARY_TIMEOUT_MS=90000
# Upstream provider timeout (server -> Kimi/Gemini)
AI_PROVIDER_TIMEOUT_MS=45000

# Test/staging API guard. Leave empty for local development.
# When XINYI_API_AUTH_TOKEN is set, /api/ai/*, /api/state/*, /api/intel/* require:
# Authorization: Bearer <token> or x-xinyi-api-token: <token>
XINYI_API_AUTH_TOKEN=
# Leave blank to enable auth automatically when XINYI_API_AUTH_TOKEN is set.
XINYI_API_AUTH_REQUIRED=
# Comma-separated browser origins allowed to call the API. Leave blank for local development only.
CORS_ALLOWED_ORIGINS=
API_JSON_LIMIT=25mb

# Official website lead intake. Keep disabled unless the public website integration is ready.
XINYI_PUBLIC_LEAD_ENABLED=false
# Optional. Use only when the website submits through a server/serverless function.
XINYI_PUBLIC_LEAD_TOKEN=

# Employee auth foundation. For local/test bootstrap only; rotate/remove seed password after first login.
AUTH_STORE_PATH=
XINYI_AUTH_STORE_PATH=
# Require employee auth data to use PostgreSQL. Test/staging/prod should set this to true.
XINYI_AUTH_REQUIRE_POSTGRES=false
XINYI_AUTH_SEED_ADMIN_EMAIL=admin@xinyi-iso.local
# If configured in test/staging/prod, use at least 12 characters.
XINYI_AUTH_SEED_ADMIN_PASSWORD=
# Test/staging smoke login account for `npm run health:auth:api`.
# Prefer a dedicated test admin account; do not use a production personal password. Minimum 12 characters in test/staging/prod.
AUTH_SMOKE_ACCOUNT=
AUTH_SMOKE_PASSWORD=
XINYI_SESSION_COOKIE_NAME=xinyi_session
# Test/staging/prod HTTPS environments should set this to true.
XINYI_SESSION_COOKIE_SECURE=false
# Idle window: the session slides forward on every authenticated request, so this is
# "how long you can be away before you must log in again", not a hard countdown.
# 28800000 = 8h; 604800000 = 7 days (recommended for the internal CRM).
XINYI_SESSION_TTL_MS=604800000
# Set to false to go back to a fixed expiry that never extends.
XINYI_SESSION_SLIDING=true
# Require employee session for protected APIs (/api/ai/*, /api/state/*, /api/intel/*).
# In test/staging/prod this should be true.
XINYI_SESSION_AUTH_REQUIRED=false
# Enable role-level checks for privileged session APIs (selftest/intel fetch).
XINYI_SESSION_ROLE_ENFORCEMENT=true
# Enable employee login gate for test/staging/prod. Keep disabled for local demo unless testing auth flow.
VITE_AUTH_REQUIRED=0

# Require PostgreSQL mode in test/staging/prod (prevents silent fallback to file store).
# `npm run health:preflight:test` expects this to be true.
XINYI_REQUIRE_POSTGRES=false
# Test/staging/prod PostgreSQL connections should require SSL, especially when using Tencent Cloud external address.
PGSSLMODE=
# Runtime store paths (optional). Default is .runtime/* when empty.
STATE_STORE_PATH=
INTEL_STORE_PATH=

# Intel Radar (daily auto fetch)
# Default behavior: enabled unless INTEL_CRON_ENABLED is explicitly set to false/0/off/no
INTEL_CRON_ENABLED=true
INTEL_CRON_HOUR=8
INTEL_CRON_MINUTE=55
INTEL_REGIONS=温州,苍南,平阳,龙港
INTEL_INDUSTRIES=塑料编织制品制造业,食包,药材,印刷,食品,餐饮
INTEL_LIMIT=20
INTEL_FETCH_TIMEOUT_MS=45000
VITE_INTEL_FETCH_TIMEOUT_MS=45000
# Optional local fallback probes for legacy dev setups. Keep disabled in test/staging/prod.
VITE_INTEL_LOCAL_FALLBACKS_ENABLED=0
INTEL_QUERY_PLAN_LIMIT=12
INTEL_WECHAT_ACCOUNTS=浙江经信,中国排污许可,质量与认证,新知探索科创,圆明园遗址公园
INTEL_WECHAT_EXCLUDE=浙江信义企业管理有限公司
INTEL_WECHAT_PLAN_MAX=5
INTEL_WECHAT_SOURCE_BOOST=6
INTEL_WECHAT_RESOLVE_LIMIT=2
INTEL_SEARCH_TIMEOUT_MS=3500
INTEL_LLM_TIMEOUT_MS=12000
# INTEL_DEBUG=true
INTEL_ENTERPRISE_KEYWORDS=企业 动态 更新 中标 订单 扩产 投产 签约 合作 融资 并购 上市 技改 数字化 智能化 专精特新 小巨人 单项冠军 龙头企业
INTEL_INDUSTRY_KEYWORDS=行业 动态 产业 趋势 市场 供需 价格 景气 出口 产业链 技术 前沿 新材料 绿色低碳 产业集群 工业互联网 智能制造
INTEL_ASSOCIATION_KEYWORDS=行业协会 商会 学会 通知 论坛 峰会 展会 博览会 研讨会 对接会 产业联盟 企业家大会

# Intel quota (default is enterprise/industry first)
INTEL_QUOTA_POLICY=1
INTEL_QUOTA_INDUSTRY=3
INTEL_QUOTA_COMPANY=4
INTEL_QUOTA_TENDER=2

# Freshness windows
INTEL_RECENCY_POLICY_DAYS=90
INTEL_RECENCY_TENDER_DAYS=90
INTEL_RECENCY_STANDARD_DAYS=90
INTEL_RECENCY_INDUSTRY_DAYS=90
INTEL_RECENCY_COMPANY_DAYS=90
INTEL_RECENCY_EVENT_DAYS=90
INTEL_UNDATED_MAX_AGE_DAYS=45

# State sync gray rollout
VITE_STATE_SYNC_ENABLED=1
VITE_STATE_SYNC_READ_ENABLED=0
VITE_STATE_SYNC_DEBOUNCE_MS=1200
VITE_STATE_SYNC_CANARY_USERS=U-BOSS,U-CONSULTANT-1,U-FINANCE-1

# Leads API gray rollout
VITE_LEADS_API_ENABLED=0
VITE_LEADS_API_READ_ENABLED=0
VITE_LEADS_API_VERIFY_WRITES_ENABLED=0

# Customers API gray rollout
VITE_CUSTOMERS_API_ENABLED=0
VITE_CUSTOMERS_API_READ_ENABLED=0
VITE_CUSTOMERS_API_VERIFY_WRITES_ENABLED=0

# Contracts API gray rollout
VITE_CONTRACTS_API_READ_ENABLED=0
VITE_CONTRACTS_API_WRITE_ENABLED=0
VITE_CONTRACTS_API_VERIFY_WRITES_ENABLED=0

# Projects API gray rollout
VITE_PROJECTS_API_READ_ENABLED=0
VITE_PROJECTS_API_WRITE_ENABLED=0
VITE_PROJECTS_API_VERIFY_WRITES_ENABLED=0

# 示例数据种子（P0-5）。默认关闭。
# 只在需要给人演示空系统时临时开 1；上线和测试环境必须保持关闭，
# 否则示例数据会和真实业务数据混在一起，问题分不清是系统的还是假数据造成的。
VITE_DEMO_SEED_ENABLED=

# ── 企业微信 ───────────────────────────────────────────────────
# 两条通道，用途不同：
#   应用消息   → 发给公司内部成员本人（任务逾期提醒这类）
#   群机器人   → 推到群里（周报汇总这类），内部群可 @ 成员
#
# 拿到密钥后先跑：npm run wecom:check
#
# 企业 ID：企业微信管理后台 →「我的企业」页面最下方
WECOM_CORP_ID=
# 自建应用的 AgentId 和 Secret：管理后台 →「应用管理」→ 点进你建的应用
WECOM_AGENT_ID=
WECOM_SECRET=
# 群机器人 webhook（可选）：群里 → 右上角 → 添加群机器人 → 复制 Webhook 地址
WECOM_GROUP_WEBHOOK=
# 提醒推送总开关。默认关闭——没验证通就打开，会在同事那边制造噪音
WECOM_PUSH_ENABLED=false

# 注意：**不要**尝试对接微信个人号（PC Hook / iPad 协议之类）。
# 那违反微信使用规范，封号风险高。要触达客户个人微信，
# 正规路径是企业微信的「外部联系人」，前提是客户先加了公司的企业微信。
