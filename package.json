{
  "name": "xinyi-certification-system-v5",
  "version": "5.0.0",
  "description": "信义认证系统 V5.0 - Enterprise Management System",
  "scripts": {
    "start": "node server/app.js",
    "start:guard": "node scripts/backend-supervisor.mjs",
    "dev:ui": "vite",
    "dev": "node scripts/dev-all.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/test-db-reset.mjs",
    "test": "node --test --test-concurrency=1 tests/**/*.test.js",
    "e2e": "playwright test",
    "health:stack": "node scripts/check-stack.mjs",
    "health:state:postgres": "node scripts/check-state-mode.mjs",
    "health:auth:postgres": "node scripts/check-auth-mode.mjs",
    "health:auth:api": "node scripts/auth-api-smoke.mjs",
    "health:local-auth": "node scripts/local-auth-smoke.mjs",
    "health:state:persistence": "node scripts/state-persistence-smoke.mjs",
    "health:leads:api": "node scripts/leads-api-smoke.mjs",
    "health:preflight:test": "node scripts/preflight-deploy.mjs --profile=test --strict=true",
    "health:preflight:dev": "node scripts/preflight-deploy.mjs --profile=dev --strict=false",
    "health:test-domain": "node scripts/test-domain-smoke.mjs",
    "health:deploy": "node scripts/deploy-smoke.mjs",
    "health:stability": "node scripts/stability-smoke.mjs",
    "security:bundle": "node scripts/check-frontend-secrets.mjs",
    "health:customers:api": "node scripts/customers-api-smoke.mjs",
    "health:contracts:api": "node scripts/contracts-api-smoke.mjs",
    "health:projects:api": "node scripts/projects-api-smoke.mjs",
    "health:test-env": "node scripts/test-env-acceptance.mjs",
    "verify:local": "npm run typecheck && npm run test && npm run build && npm run security:bundle && npm run migrate:lint && npm run health:permissions && npm run health:preflight:dev && npm run e2e",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "acceptance:record": "node scripts/generate-acceptance-record.mjs",
    "build:metrics": "esbuild services/dashboardMetrics.ts --bundle --platform=node --format=cjs --outfile=server/generated/dashboardMetrics.cjs",
    "health:permissions": "node scripts/check-permission-matrix.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "backup:drill": "node scripts/backup-drill.mjs",
    "migrate": "node scripts/migrate.mjs",
    "test:db:setup": "node scripts/test-db-setup.mjs",
    "mirror:diff": "node scripts/mirror-diff.mjs",
    "backfill:projects": "node scripts/backfill-legacy-projects.mjs",
    "backfill:industry": "node scripts/backfill-customer-industry.mjs",
    "backfill:tags": "node scripts/backfill-knowledge-tags.mjs",
    "wecom:check": "node scripts/wecom-check.mjs",
    "readiness": "node scripts/readiness.mjs",
    "test:enforce": "XINYI_AUTHZ_SCENARIO_MODE=enforce node --test --test-concurrency=1 tests/role-scenarios.test.js tests/cross-module-chain.test.js",
    "migrate:status": "node scripts/migrate.mjs --status",
    "migrate:new": "node scripts/migrate.mjs --new",
    "migrate:lint": "node scripts/migrate.mjs --lint",
    "data:plan": "node scripts/data-cleanup-plan.mjs",
    "health:ui": "node scripts/health-ui.mjs",
    "health:data": "node scripts/health-data.mjs",
    "health:dashboard": "node scripts/health-dashboard.mjs",
    "health:views": "node scripts/health-views.mjs",
    "migrate:state": "node scripts/migrate-state-store-to-pg.mjs",
    "authz:report": "node scripts/authz-report.mjs",
    "health:auth:gate": "node scripts/health-auth-gate.mjs",
    "health:ai": "node scripts/health-ai-behavior.mjs",
    "state:history": "node scripts/state-history.mjs",
    "auth:migrate:pg": "node scripts/migrate-auth-to-postgres.mjs",
    "backfill:contract-owner": "node scripts/backfill-contract-owner.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "lucide-react": "^0.292.0",
    "mammoth": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "pdfjs-dist": "^5.4.624",
    "pg": "^8.18.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.10.1",
    "remark-gfm": "^4.0.0",
    "sharp": "^0.35.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.2.3",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "nodemon": "^3.0.2",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2",
    "vite": "^5.0.0"
  }
}
